{
  "name": "resonance-vue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src tests",
    "format": "prettier --write src tests *.json *.ts *.md index.html",
    "format:check": "prettier --check src tests *.json *.ts *.md index.html",
    "build:static": "vite build --mode static --outDir dist-static",
    "preview:static": "vite preview --outDir dist-static --host 127.0.0.1",
    "test:static": "npm run build:static && playwright test --config playwright.static.config.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.43.0",
    "astronomy-engine": "^2.1.19",
    "three": "^0.186.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^26.5.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "jiti": "^2.7.0",
    "prettier": "^3.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
